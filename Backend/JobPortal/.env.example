# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# ---- MySQL ----
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- JWT ----
# Must be at least 32 characters (HMAC-SHA256 requires 256 bits).
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# ---- Cloudinary (optional to boot, required for resume / picture upload) ----
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- SMTP (optional, only needed to send emails) ----
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME=JobHub
